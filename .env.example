# Telegram bot from @BotFather
TELEGRAM_BOT_TOKEN=
# Comma-separated Telegram user IDs allowed to use the bot (everyone else is ignored)
ADMIN_TELEGRAM_IDS=
# Optional: socks5://user:pass@host:port or http://... if Telegram is blocked
TELEGRAM_PROXY=

# Lolz Market API token (https://lzt.market/account/api). Scope "market" is enough.
LOLZ_API_TOKEN=
LOLZ_API_BASE=https://prod-api.lzt.market

# Signature in the bottom-right corner of every slide; empty = none
WATERMARK=

# Empty = auto-detect chromium-headless-shell / Chrome / Edge
CHROMIUM_PATH=
# Tank image cache
DATA_DIR=data
