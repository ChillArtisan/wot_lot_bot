{% extends "base.html.j2" %}
{% from "cells.j2" import cell %}
{% block kind %}cover{% endblock %}
{% block body %}
  <main class="cover-body">
    <section class="form">
      {% for row in rows %}
      <div class="row">
        {% for label, value in row %}
        <div class="f"><span class="l">{{ label }}</span><span class="typed v">{{ value }}</span></div>
        {% endfor %}
      </div>
      {% endfor %}
      <div class="tally">
        {% for label, value in tally %}
        <div class="t"><span class="l">{{ label }}</span><span class="typed n">{{ value }}</span></div>
        {% endfor %}
      </div>
    </section>
    <section class="photos">
      <div class="ph-title">Фотографии машин</div>
      <div class="ph-grid">
        {% for c in hero %}{{ cell(c, true) }}{% endfor %}
        {% for _ in range(4 - hero | length) %}<div class="cell"></div>{% endfor %}
      </div>
    </section>
  </main>
{% endblock %}
