{% macro cell(c) -%}
<figure class="cell">
  <span class="tier">{{ c.tier }}</span>
  {% if c.nation %}<span class="nation">{{ c.nation }}</span>{% endif %}
  <img src="{{ c.image }}" alt="">
  <figcaption class="typed">{{ c.name }}</figcaption>
  {% if c.mark %}<span class="pstamp">{{ c.mark }}</span>{% endif %}
</figure>
{%- endmacro %}
